# --- Required for processing calls ---
# Which model analyzes calls: claude or gemini (defaults to whichever key is set)
ANALYSIS_PROVIDER=
# Claude: https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# Gemini: https://aistudio.google.com -> Get API key (turn on billing so call data is not used for training)
GEMINI_API_KEY=
# Exact Gemini model ID from AI Studio, e.g. gemini-...
GEMINI_MODEL=
# Deepgram: https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# --- Optional ---
# Postgres connection string (e.g. Neon). If empty, an embedded Postgres (PGlite) is used in ./data/pglite
DATABASE_URL=
# Vercel Blob token for audio storage. If empty, audio is stored on disk in ./data/uploads
BLOB_READ_WRITE_TOKEN=
# Override the Claude model (default: claude-opus-5-5)
ANALYSIS_MODEL=
# Employee first names (reps + technicians) that are never masked as customer details.
# PestLaunch would sync this from the CRM team list.
TEAM_ROSTER=Griffin,Kristen,Christian,Kevin,Mike,Britney,Elijah,CJ,Sam,Joe,Steve,Dwight
# Set to off to keep customer names/phones/emails/addresses in transcripts
MASK_CONTACT_DETAILS=
# Workspace name shown in the sidebar as "<name> OS"
WORKSPACE_NAME=Demo Pest Co
# First-year customer value used when no price is said on a call
DEFAULT_ANNUAL_VALUE=650
# Gemini requests per minute (free tier: 5)
GEMINI_RPM=5
# Protects /api/admin/import in production (used by npm run seed)
ADMIN_TOKEN=
